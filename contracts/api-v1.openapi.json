  "components": {
    "schemas": {
      "ActualPresence": {
        "type": "string",
        "enum": [
          "present",
          "absent"
        ],
        "title": "ActualPresence"
      },
      "ClockAnchor": {
        "properties": {
          "utc_ms": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Utc Ms"
          },
          "uptime_ms": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Uptime Ms"
          },
          "source": {
            "$ref": "#/components/schemas/ClockSource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "utc_ms",
          "uptime_ms",
          "source"
        ],
        "title": "ClockAnchor"
      },
      "ClockSource": {
        "type": "string",
        "enum": [
          "sntp",
          "rtc"
        ],
        "title": "ClockSource"
      },
      "ConfigPut": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Base Revision"
          },
          "created_by": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Created By",
            "default": "api"
          },
          "config": {
            "$ref": "#/components/schemas/PresenceConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision",
          "config"
        ],
        "title": "ConfigPut"
      },
      "ConfigResponse": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "created_at_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At Ms"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "config": {
            "$ref": "#/components/schemas/PresenceConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "device_id",
          "revision",
          "created_at_ms",
          "created_by",
          "config"
        ],
        "title": "ConfigResponse"
      },
      "FeedbackCreate": {
        "properties": {
          "feedback_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Feedback Id"
          },
          "boot_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 16,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Boot Id"
          },
          "seq": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.223372036854776e+18,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq"
          },
          "actual_presence": {
            "$ref": "#/components/schemas/ActualPresence"
          },
          "observed_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresenceState"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/FeedbackSource"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feedback_id",
          "actual_presence",
          "source"
        ],
        "title": "FeedbackCreate"
      },
      "FeedbackPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedbackResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "truncated",
          "next_cursor"
        ],
        "title": "FeedbackPage"
      },
      "FeedbackResponse": {
        "properties": {
          "feedback_id": {
            "type": "string",
            "title": "Feedback Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "boot_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Boot Id"
          },
          "seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seq"
          },
          "created_at_ms": {
            "type": "integer",
            "title": "Created At Ms"
          },
          "occurred_at_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At Ms"
          },
          "occurred_uptime_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred Uptime Ms"
          },
          "time_quality": {
            "type": "string",
            "title": "Time Quality"
          },
          "actual_presence": {
            "$ref": "#/components/schemas/ActualPresence"
          },
          "observed_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresenceState"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/FeedbackSource"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feedback_id",
          "device_id",
          "boot_id",
          "seq",
          "created_at_ms",
          "occurred_at_ms",
          "occurred_uptime_ms",
          "time_quality",
          "actual_presence",
          "observed_state",
          "source",
          "note"
        ],
        "title": "FeedbackResponse"
      },
      "FeedbackSource": {
        "type": "string",
        "enum": [
          "touch",
          "web",
          "api"
        ],
        "title": "FeedbackSource"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "server_utc_ms": {
            "type": "integer",
            "title": "Server Utc Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ok",
          "database",
          "server_utc_ms"
        ],
        "title": "HealthResponse"
      },
      "IngestResponse": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "stored": {
            "type": "integer",
            "title": "Stored"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          },
          "max_seq": {
            "type": "integer",
            "title": "Max Seq"
          },
          "server_utc_ms": {
            "type": "integer",
            "title": "Server Utc Ms"
          },
          "desired_config_revision": {
            "type": "integer",
            "title": "Desired Config Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "batch_id",
          "stored",
          "duplicates",
          "max_seq",
          "server_utc_ms",
          "desired_config_revision"
        ],
        "title": "IngestResponse"
      },
      "PresenceConfig": {
        "properties": {
